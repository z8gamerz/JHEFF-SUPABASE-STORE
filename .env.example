# Server-only secrets (NEVER prefix with VITE_ — VITE_* values are exposed to the browser bundle)
FIREBASE_DATABASE_SECRET=
FIREBASE_RTDB_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=
POS_API_SECRET=

# Client-safe (public) config — do not put secrets here
GEMINI_API_KEY=
VITE_FIREBASE_RTDB_URL=
VITE_FIREBASE_AUTH_TOKEN=
VITE_APP_ORIGIN=http://localhost:3000

# CORS allowlist for API routes (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,https://your-deployed-domain.example
